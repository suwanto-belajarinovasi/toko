# TURSO DATABASE CONFIGURATION
# Dapatkan dari dashboard Turso (turso db show --url <dbname>)
TURSO_DATABASE_URL="libsql://namadb-username.turso.io"
# Dapatkan dari (turso db tokens create <dbname>)
TURSO_AUTH_TOKEN="your-turso-auth-token-here"

# NEXT.JS & APP CONFIG
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Generate string acak (misal: openssl rand -base64 32) untuk enkripsi session/cookie
AUTH_SECRET="your-secure-random-string"

# WHATSAPP KONFIRMASI PEMBAYARAN
NEXT_PUBLIC_WHATSAPP_NUMBER="085895283075"

# ADMIN DEFAULT (Digunakan saat seed database pertama kali)
ADMIN_EMAIL="admin@belajarinovasi.com"
ADMIN_PASSWORD="supersecretpassword"
